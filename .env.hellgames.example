# Discord bot token. Do not commit the real token.
HELLGAMES_TOKEN=

# Optional but recommended for fast slash-command sync while testing.
DISCORD_GUILD_ID=

# Optional owner/admin allowlist. Use Discord user IDs separated by commas.
HELLGAMES_OWNER_IDS=
HELLGAMES_ADMIN_ROLE_IDS=

# Channel IDs. Enable Developer Mode in Discord, right-click channel, Copy ID.
HG_ACTION_CHANNEL_ID=
HG_PUBLIC_MAP_CHANNEL_ID=
HG_PUBLIC_LOG_CHANNEL_ID=
HG_RUMORS_CHANNEL_ID=
HG_ADMIN_LOG_CHANNEL_ID=
HG_ASSET_CHANNEL_ID=
HG_DATABASE_CHANNEL_ID=
HG_DEBUG_CHANNEL_ID=
